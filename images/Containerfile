FROM quay.io/fedora/fedora-bootc:41

COPY overlays/os-release /usr/lib/os-release
COPY images/packages.list /tmp/packages.list

RUN dnf -y install $(grep -v '^#' /tmp/packages.list | tr '\n' ' ') \
    && dnf clean all \
    && rm -f /tmp/packages.list

COPY presets/sorabbyngo.preset /usr/lib/systemd/system-preset/80-sorabbyngo.preset

RUN bootc container lint || true
