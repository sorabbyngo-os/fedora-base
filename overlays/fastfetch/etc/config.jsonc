{
  "logo": {
    "type": "chafa",
    "source": "/usr/share/pixmaps/sorabbyngo-logo.png",
    "width": 32,
    "height": 16,
    "preserveAspectRatio": true
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS",
      "format": "{name}"
    },
    {
      "type": "custom",
      "key": "Version",
      "format": "{#}OS ONE 1.0"
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory"
  ]
}
